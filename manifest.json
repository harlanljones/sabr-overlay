{
  "manifest_version": 2,
  "name": "SABR Overlay",
  "version": "0.2.0",
  "description": "Live sabermetrics panels over YouTube TV MLB broadcasts, powered by the MLB StatsAPI.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sabr-overlay@harlanljones.github.io",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["https://statsapi.mlb.com/*", "https://baseballsavant.mlb.com/*", "storage"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://tv.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
